#!/usr/bin/env bash
# Remove a branch.<current-branch>.<key> config value.
#
# Usage:
# git bunset <key>

set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: git bunset <key>" >&2
  exit 1
fi

BRANCH=$(git symbolic-ref --short HEAD) || {
  echo "git bunset: not on a branch" >&2
  exit 1
}

git config --unset "branch.${BRANCH}.${1}"
